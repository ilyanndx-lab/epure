# ─────────────────────────────────────────────────────────────────────────────
# Épure — configuration backend (exemple)
#
# Copiez ce fichier en `.env` (dans backend/) et renseignez les valeurs voulues.
# TOUTES les variables sont OPTIONNELLES : l'application démarre sans aucune
# d'elles. Le fichier `.env` n'est jamais committé (voir .gitignore).
#
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Clés API des fournisseurs LLM cloud (optionnelles) ───────────────────────
# Sans clé, seuls les modèles locaux Ollama sont utilisables. Renseignez
# uniquement les fournisseurs auxquels vous avez accès.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=

DEEPSEEK_API_KEY=

# ── Portabilité / déploiement (optionnelles) ─────────────────────────────────

# Dossier racine des fiches PDF analysées/surveillées.
# Défaut : <racine_du_repo>/data/fiches  (portable, créé au besoin).
# Exemples : /data/fiches (Docker)  |  C:\Users\moi\Fiches (Windows)
# EPURE_FICHES_DIR=

# Dossier de travail du codeagent (fichiers générés/exécutés par l'atelier).
# Défaut : <racine_du_repo>/workspace  (portable). Sert de racine de
# confinement : aucun accès n'est autorisé en dehors de ce dossier.
# EPURE_WORKSPACE=

# ── Exposition réseau (optionnelles) ─────────────────────────────────────────

# Interface d'écoute du backend, appliquée par epure_tray.py.
# Défaut : 127.0.0.1 — l'API n'est joignable que depuis cette machine.
#
# AVERTISSEMENT : 0.0.0.0 ouvre le port 8000 à tout le réseau local. L'API n'est
# alors protégée que par un token, et elle expose l'agent de code et l'Atelier,
# donc l'exécution de commandes sur la machine. Sur un wifi partagé, à n'utiliser
# qu'en connaissance de cause — et complétez EPURE_ALLOWED_HOSTS ci-dessous,
# sinon toutes les requêtes seront rejetées (400 Invalid host header).
# EPURE_BIND=127.0.0.1

# En-têtes Host acceptés par l'API, séparés par des virgules.
# Défaut : localhost,127.0.0.1,::1
#
# Garde-fou anti DNS rebinding : une page web dont le domaine résout vers
# 127.0.0.1 se présente à l'API comme un client local (CORS ne s'applique pas,
# request.client.host vaut 127.0.0.1) et pourrait lui soutirer le token via
# /pair. Seul l'en-tête Host la distingue encore du frontend légitime.
# À compléter avec le nom d'hôte / l'IP utilisés si EPURE_BIND est ouvert au LAN.
# EPURE_ALLOWED_HOSTS=localhost,127.0.0.1,::1,192.168.1.20

# Origines autorisées pour CORS, séparées par des virgules.
# Défaut : http://localhost:5173,http://127.0.0.1:5173
# EPURE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Niveau de log : DEBUG | INFO | WARNING | ERROR  (défaut : INFO)
# EPURE_LOG_LEVEL=INFO

# Hôte du serveur Ollama (défaut : http://localhost:11434).
# En Docker compose avec le service ollama : http://ollama:11434
# OLLAMA_HOST=http://localhost:11434
